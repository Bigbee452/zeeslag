@startuml
skinparam classAttributeIconSize 0

interface IBattleshipSoloGame {
    +getRowCount(): int
    +getColumnCount(): int
    +getCellContent(pos: Position, forOwner: boolean): String
    +getCellContentImage(pos: Position): String
    +shoot(pos: Position)
    +isGameOver(): boolean
    +getMoveCount(): int
    +shipSunk(pos: Position): String
}

Class BattleshipSoloGame {
    -grid: Grid
    -moveCount: int
    --
    +BattleshipSoloGame(dao: DAO)
}
IBattleshipSoloGame <|.. BattleshipSoloGame
@enduml
